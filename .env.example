# ==============================================================================
# AI AUTOMATED TRADING TELEGRAM BOT CONFIGURATION
# ==============================================================================

# Telegram Bot Token (Obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Admin Telegram User IDs (comma-separated, get your ID from @userinfobot)
ADMIN_USER_IDS=123456789

# Private Monitor Channel ID — get chat ID of your private channel (bot must be admin there)
# Leave blank to disable channel alerts. Example: -1001234567890 or @alertsnotices
MONITOR_CHANNEL_ID=@alertsnotices

# MongoDB Connection String (For Render cloud dashboard syncing)
MONGODB_URI=

AI_PROVIDER=builtin

# Optional AI API Keys (leave blank to use the built-in Quantitative Multi-Factor AI Engine)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Default Trading Mode: 'paper' (simulated risk-free) or 'live' (real exchange)
DEFAULT_TRADING_MODE=paper

# Exchange Connectivity (Binance, Bybit, OKX)
DEFAULT_EXCHANGE=binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# Risk Management
DEFAULT_PAPER_BALANCE=10000.0
DEFAULT_RISK_PERCENT=2.0
DEFAULT_LEVERAGE=1
MAX_OPEN_POSITIONS=5
CHECK_INTERVAL_SECONDS=15
